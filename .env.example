# Copy to .env.local for development, and add the same keys in Vercel → Settings → Environment Variables.
# With no Sanity or Clerk keys the app runs in local mode: content is stored in .data/
# and a development-only sign-in screen replaces Clerk. That mode never runs in production.

# The public address (https://marilicht.social) is fixed in lib/config.ts so QR codes can never change.
NEXT_PUBLIC_SITE_NAME=Marilicht

# Sanity (sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Server only. An Editor token from sanity.io/manage → API → Tokens. Never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# Shared secret for the /api/revalidate webhook (any long random string)
SANITY_REVALIDATE_SECRET=

# Clerk (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# The administrator's email (must be verified in Clerk). Comma-separate if you ever need a second one.
ADMIN_EMAILS=
